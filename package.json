{
  "name": "m-generation-ii-pos",
  "version": "1.0.0",
  "description": "M Generation II Co. Ltd hotel and restaurant point-of-sale application",
  "main": "electron/main.cjs",
  "author": "M Generation II Co. Ltd",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:mac:universal": "npm run build && electron-builder --mac dmg --universal",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sql.js": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.mgeneration2.pos",
    "productName": "M Generation II POS",
    "artifactName": "M-Generation-II-POS-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/app-icon.png",
      "build/app-icon.ico",
      "package.json",
      "node_modules/sql.js/dist/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "M Generation II POS"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/app-icon.png",
      "category": "public.app-category.business",
      "darkModeSupport": true
    },
    "publish": {
      "provider": "github",
      "owner": "TimothyFesto",
      "repo": "POS_APP_DEV",
      "releaseType": "release"
    }
  }
}
